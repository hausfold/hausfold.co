# wrangler's local account/asset cache — machine state, not source.
.wrangler/
.DS_Store

# `nix build github:hausfold/nebelung` drops a store symlink here, and
# scripts/sync-nebelung.mjs's --from flag invites exactly that.
result
result-*

# --- the docs build (Next + Fumadocs, static export) -------------------
# `out/` is what wrangler now serves, and it is generated: Next copies
# `public/` into it verbatim and writes the exported docs beside them. It
# must never be committed — a stale checked-in export is a site that lies.
/node_modules
/.next/
/out/
/build
.source
*.tsbuildinfo
next-env.d.ts
.env*.local
