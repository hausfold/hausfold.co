# Response headers for the Cloudflare assets binding.
#
# Two rules, and the first one is the load-bearing one.
#
# `/api/search` is the whole search index — a serialized Orama database,
# fetched lazily on a reader's FIRST query and cached per URL afterwards, so
# nobody pays for it unless they open search. It IS JSON, but Next writes it
# with **no file extension**, and Cloudflare infers content type from the
# extension: left alone it can go out as `application/octet-stream`, which is
# not on the compressible list, which means the index ships uncompressed. The
# difference measured on a full corpus was 4.2 MB versus ~457 KB brotli'd,
# with nothing failing or warning in between. Naming the type is what makes
# the compression happen.
#
# Verify it on the deployed URL rather than trusting this file:
#
#   curl -sI -H 'Accept-Encoding: br' https://hausfold.co/api/search \
#     | grep -i 'content-type\|content-encoding'
/api/search
  Content-Type: application/json; charset=utf-8

# /auth.md is markdown for agents; without a rule, the extensionless-vendor
# logic that mangles /api/search is not the issue but Cloudflare infers from
# the extension and .md is served as text/markdown by some stacks and as
# application/octet-stream by others. Name it, like /api/search above.
/auth.md
  Content-Type: text/markdown; charset=utf-8

# The structured-data feed the robots.txt schemamap line advertises. Same
# shape of problem as /api/search: a route handler output with no file
# extension Cloudflare recognises, left alone it ships as octet-stream.
/schema.jsonl
  Content-Type: application/x-jsonlines; charset=utf-8

# The same JSON-LD graph as one document, and the same extension problem:
# .jsonld is not in Cloudflare's table either.
/index.jsonld
  Content-Type: application/ld+json; charset=utf-8

# Next's own assets are content-hashed, so their URL changes whenever their
# bytes do and they can be cached forever. Nothing else here may be — every
# hand-written page and `hausfold.css` keeps its URL across a content change,
# which is why deploy.yml purges the cache.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
